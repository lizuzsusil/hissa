rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Whether the signed-in user belongs to household `householdId`.
    // Membership docs are keyed `${householdId}_${auth.uid}`.
    function memberOf(householdId) {
      return householdId != null && exists(
        /databases/$(database)/documents/householdMembers/$(householdId)_$(request.auth.uid)
      );
    }

    // The Space mode must be one of the supported values; a create/update that
    // omits `mode` is rejected so a Space can never be saved without one.
    function validSpaceMode() {
      return request.resource.data.mode in ['SPLIT', 'SOLO'];
    }

    // Whether the user identified by `userId` is a member of `householdId`.
    function memberById(householdId, userId) {
      return userId != null && exists(
        /databases/$(database)/documents/householdMembers/$(householdId)_$(userId)
      );
    }

    // Whether every participant-group member listed on an expense belongs to
    // the Space. Prevents a client from creating a participant group that
    // contains users outside the Space (Phase 8 security).
    function validParticipantGroups(householdId) {
      return request.resource.data.participantGroups is list
        && request.resource.data.participantGroups.all(
             group => group.userIds is list
               && group.userIds.all(uid => memberById(householdId, uid))
           );
    }

    // Public profile + pseudo member profiles. Reads are open to any signed-in
    // user; each user may update only their own profile.
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if signedIn() && request.auth.uid == userId;
    }

    // Household documents are readable by any signed-in user so invite-code
    // joins work. Writes (create via onboarding, later edits by the owner)
    // require membership in the household and a valid mode.
    match /households/{householdId} {
      allow read: if signedIn();
      allow write: if signedIn() && memberOf(householdId) && validSpaceMode();
    }

    match /householdMembers/{memberId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        memberOf(resource.data.householdId)
      );
      allow create: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        memberOf(resource.data.householdId)
      );
      allow update, delete: if signedIn() && memberOf(resource.data.householdId);
    }

    match /categories/{categoryId} {
      allow read: if signedIn() && memberOf(resource.data.householdId);
      allow write: if signedIn() && memberOf(request.resource.data.householdId);
    }

    match /cycles/{cycleId} {
      allow read: if signedIn() && memberOf(resource.data.householdId);
      allow write: if signedIn() && memberOf(request.resource.data.householdId);
    }

    match /expenses/{expenseId} {
      allow read: if signedIn() && memberOf(resource.data.householdId);
      // Only the authenticated creator may create an expense on their own
      // behalf; `createdBy` and `paidByUserId` are never accepted blindly from
      // the client. The payer must always be the authenticated user (Phase 5).
      allow create: if signedIn() && memberOf(request.resource.data.householdId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.paidByUserId == request.auth.uid
        && validParticipantGroups(request.resource.data.householdId);
      // Only the creator may update/delete an expense. Legacy expenses without
      // a `createdBy` are locked until migrated (Phase 7). The payer is
      // immutable: it can never be reassigned once the expense exists.
      allow update: if signedIn() && memberOf(request.resource.data.householdId)
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.paidByUserId == resource.data.paidByUserId
        && validParticipantGroups(request.resource.data.householdId);
      allow delete: if signedIn() && memberOf(resource.data.householdId)
        && resource.data.createdBy == request.auth.uid;
    }

    match /expenseShares/{shareId} {
      allow read: if signedIn() && memberOf(resource.data.householdId);
      // The share's user must be a member of the Space; a client can never
      // mint a share for a user outside the Space (Phase 8 security).
      allow write: if signedIn() && memberOf(request.resource.data.householdId)
        && memberById(
             request.resource.data.householdId,
             request.resource.data.userId
           );
    }

    match /settlements/{settlementId} {
      allow read: if signedIn() && memberOf(resource.data.householdId);
      allow write: if signedIn() && memberOf(request.resource.data.householdId);
    }
  }
}
