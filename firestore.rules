rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Whether the signed-in user belongs to space `spaceId`.
    // Membership docs are keyed `${spaceId}_${auth.uid}`.
    function memberOf(spaceId) {
      return spaceId != null && exists(
        /databases/$(database)/documents/spaceMembers/$(spaceId + '_' + request.auth.uid)
      );
    }

    // The Space mode must be one of the supported values; a create/update that
    // omits `mode` is rejected so a Space can never be saved without one.
    function validSpaceMode() {
      return request.resource.data.mode in ['SPLIT', 'PERSONAL'];
    }

    // Whether the user identified by `userId` is a member of `spaceId`.
    function memberById(spaceId, userId) {
      return userId != null && exists(
        /databases/$(database)/documents/spaceMembers/$(spaceId + '_' + userId)
      );
    }

    // Whether the signed-in user is the owner (highest role) of `spaceId`.
    function spaceOwner(spaceId) {
      return spaceId != null && exists(
        /databases/$(database)/documents/spaceMembers/$(spaceId + '_' + request.auth.uid)
      ) && get(
        /databases/$(database)/documents/spaceMembers/$(spaceId + '_' + request.auth.uid)
      ).data.role == 'owner';
    }

    // Whether `groupId` belongs to `spaceId`.
    function groupInSpace(spaceId, groupId) {
      return groupId != null && exists(
        /databases/$(database)/documents/memberGroups/$(groupId)
      ) && get(
        /databases/$(database)/documents/memberGroups/$(groupId)
      ).data.spaceId == spaceId;
    }

    // Whether the signed-in user owns the group identified by `groupId`.
    function groupOwner(groupId) {
      return groupId != null && exists(
        /databases/$(database)/documents/memberGroups/$(groupId)
      ) && get(
        /databases/$(database)/documents/memberGroups/$(groupId)
      ).data.ownerUserId == request.auth.uid;
    }

    // Public profile + pseudo member profiles. Reads are open to any signed-in
    // user; each user may update only their own profile.
    match /users/{userId} {
      allow read: if signedIn();

      // A signed-in user can only create their own user document.
      allow create: if signedIn() && request.auth.uid == userId;

      allow update, delete: if signedIn() && request.auth.uid == userId;
    }

    // Space documents are readable by any signed-in user so invite-code
    // joins work. Writes (create via onboarding, later edits by the owner)
    // require membership in the space and a valid mode.
    match /spaces/{spaceId} {
      allow read: if signedIn();

      allow write: if signedIn()
        && memberOf(spaceId)
        && validSpaceMode();
    }

    match /spaceMembers/{memberId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        memberOf(resource.data.spaceId)
      );

      allow create: if signedIn() && (
        request.resource.data.userId == request.auth.uid ||
        memberOf(request.resource.data.spaceId)
      );

      allow update, delete: if signedIn()
        && memberOf(resource.data.spaceId);
    }

    match /categories/{categoryId} {
      allow read: if signedIn()
        && memberOf(resource.data.spaceId);

      allow write: if signedIn()
        && memberOf(request.resource.data.spaceId);
    }

    match /cycles/{cycleId} {
      allow read: if signedIn()
        && memberOf(resource.data.spaceId);

      allow write: if signedIn()
        && memberOf(request.resource.data.spaceId);
    }

    match /expenses/{expenseId} {
      allow read: if signedIn()
        && memberOf(resource.data.spaceId);

      // Only the authenticated creator may create an expense on their own
      // behalf; `createdBy` and `paidByUserId` are never accepted blindly from
      // the client. The payer must always be the authenticated user (Phase 5).
      allow create: if signedIn()
        && memberOf(request.resource.data.spaceId)
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.paidByUserId == request.auth.uid;

      // Only the creator may update/delete an expense. Legacy expenses without
      // a `createdBy` are locked until migrated (Phase 7). The payer is
      // immutable: it can never be reassigned once the expense exists.
      allow update: if signedIn()
        && memberOf(request.resource.data.spaceId)
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.paidByUserId == resource.data.paidByUserId;

      allow delete: if signedIn()
        && memberOf(resource.data.spaceId)
        && resource.data.createdBy == request.auth.uid;
    }

    match /expenseShares/{shareId} {
      allow read: if signedIn()
        && memberOf(resource.data.spaceId);

      // A share is either for an individual Space member (USER) or for a
      // persistent Member Group (GROUP). A client can never mint a share for a
      // user outside the Space, nor for a group outside the Space (Phase 8
      // security). Group shares carry a null `userId` and a `memberGroupId`.
      allow write: if signedIn()
        && memberOf(request.resource.data.spaceId)
        && (
          (request.resource.data.participantType == 'GROUP'
            && groupInSpace(
              request.resource.data.spaceId,
              request.resource.data.memberGroupId
            ))
          ||
          (request.resource.data.participantType != 'GROUP'
            && memberById(
              request.resource.data.spaceId,
              request.resource.data.userId
            ))
        );
    }

    match /settlements/{settlementId} {
      allow read: if signedIn()
        && memberOf(resource.data.spaceId);

      allow write: if signedIn()
        && memberOf(request.resource.data.spaceId);
    }

    match /memberGroups/{groupId} {
      allow read: if signedIn()
        && memberOf(resource.data.spaceId);

      allow create: if signedIn()
        && memberOf(request.resource.data.spaceId)
        && spaceOwner(request.resource.data.spaceId)
        // The Space owner creates a group, either owned by themselves or by
        // another member when approving that member's group request (Rule 5).
        && memberById(
          request.resource.data.spaceId,
          request.resource.data.ownerUserId
        );

      // Only the owner may modify a group, and the owner/Space are immutable so
      // ownership can never be silently transferred (Phase 1, §52).
      allow update: if signedIn()
        && memberOf(resource.data.spaceId)
        && resource.data.ownerUserId == request.auth.uid
        && request.resource.data.ownerUserId == resource.data.ownerUserId
        && request.resource.data.spaceId == resource.data.spaceId;

      allow delete: if signedIn()
        && memberOf(resource.data.spaceId)
        && resource.data.ownerUserId == request.auth.uid;
    }

    match /memberGroupMembers/{memberId} {
      allow read: if signedIn()
        && memberOf(resource.data.spaceId);

      // Only the group owner may add a member, the target user must belong to
      // the same Space as the group, and the target must not already be a
      // member (uniqueness is enforced by the composite doc id).
      allow create: if signedIn()
        && memberOf(request.resource.data.spaceId)
        && groupInSpace(
          request.resource.data.spaceId,
          request.resource.data.groupId
        )
        && groupOwner(request.resource.data.groupId)
        && memberById(
          request.resource.data.spaceId,
          request.resource.data.userId
        );

      // Only the group owner may remove a member.
      allow delete: if signedIn()
        && memberOf(resource.data.spaceId)
        && groupOwner(resource.data.groupId);
    }

    match /groupRequests/{requestId} {
      // Only the requester, the Space owner, and other members of the Space may
      // read a request.
      allow read: if signedIn()
        && memberOf(resource.data.spaceId);

      // A non-owner member may submit a request on their own behalf. It must be
      // created as pending, and the requester must not be the Space owner.
      allow create: if signedIn()
        && memberOf(request.resource.data.spaceId)
        && request.resource.data.requesterUserId == request.auth.uid
        && !spaceOwner(request.resource.data.spaceId)
        && request.resource.data.status == 'pending';

      // Only the Space owner may approve or reject a request (Rule 5). A
      // request can only change its status, never its requester.
      allow update: if signedIn()
        && memberOf(resource.data.spaceId)
        && spaceOwner(resource.data.spaceId)
        && request.resource.data.requesterUserId == resource.data.requesterUserId
        && request.resource.data.status in ['approved', 'rejected'];

      allow delete: if signedIn()
        && memberOf(resource.data.spaceId)
        && spaceOwner(resource.data.spaceId);
    }
  }
}